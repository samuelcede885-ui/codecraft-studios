# Configuración de un backend futuro para el agente diario (sin secretos reales).
# Solo como referencia: el agente actual funciona dentro de la app, sin servidor.
APP_TIMEZONE=America/Caracas
DAILY_SYNC_CRON=0 7 * * *       # una vez al día
ASSIGNMENT_SOURCE=manual-import  # solo fuentes autorizadas; no scraping de Quanta
ANTHROPIC_API_KEY=               # SOLO en el servidor, nunca en el frontend
ANTHROPIC_MODEL=
NOTIFICATION_PROVIDER=webpush
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
MAX_DRAFTS_PER_RUN=30
MAX_MODEL_COST_USD_PER_DAY=2
