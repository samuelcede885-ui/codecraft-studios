{
  "name": "noa-cookies-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/flujo-compra.mjs",
    "build:artifact": "vite build --config vite.artifact.config.js && node artifact/assemble.mjs",
    "pookies:dev": "vite --mode pookies",
    "pookies:build": "vite build --mode pookies",
    "pookies:preview": "vite preview --mode pookies --port 4175",
    "pookies:test": "BRAND=pookies node tests/e2e/marca.mjs",
    "pookies:artifact": "vite build --config vite.artifact.config.js --mode pookies && node artifact/assemble.mjs pookies",
    "doradas:dev": "vite --mode doradas",
    "doradas:build": "vite build --mode doradas",
    "doradas:preview": "vite preview --mode doradas --port 4176",
    "doradas:test": "BRAND=doradas URL=http://localhost:4176/ node tests/e2e/marca.mjs",
    "doradas:artifact": "vite build --config vite.artifact.config.js --mode doradas && node artifact/assemble.mjs doradas"
  },
  "dependencies": {
    "@fontsource-variable/crimson-pro": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/dynapuff": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
